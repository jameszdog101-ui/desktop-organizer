{
  "targetFolderName": "整理 Organized",
  "groupByCategory": false,
  "groupByMonth": false,
  "groupByDay": true,
  "minAgeMinutes": 60,
  "watchIntervalSeconds": 900,
  "autoArrangeDesktop": true,
  "autoFreeMemoryThresholdPercent": 85,
  "keepExtensions": [".exe", ".appref-ms"],
  "keepKeywords": ["重要", "重點", "important", "urgent", "緊急", "合約", "contract", "待辦", "todo"],
  "keepPrefixes": ["★", "!", "！"],
  "ignoreExtensions": [".lnk", ".url", ".ini", ".tmp", ".crdownload", ".part", ".partial", ".download", ".opdownload"],
  "ignoreNames": ["desktop.ini", "thumbs.db", "桌面整理工具說明書 manual.txt"],
  "keywordRules": [
    { "keywords": ["發票", "invoice", "收據", "receipt"], "category": "財務 Finance" }
  ],
  "categories": {
    "圖片 Images": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".svg", ".ico", ".heic", ".tif", ".tiff"],
    "文件 Documents": [".pdf", ".doc", ".docx", ".txt", ".xls", ".xlsx", ".ppt", ".pptx", ".csv", ".md", ".odt", ".rtf", ".hwp"],
    "壓縮檔 Archives": [".zip", ".rar", ".7z", ".tar", ".gz", ".bz2"],
    "影音 Media": [".mp4", ".mov", ".avi", ".mkv", ".mp3", ".wav", ".flac", ".m4a", ".wmv"],
    "程式碼 Code": [".py", ".js", ".ts", ".html", ".css", ".json", ".ps1", ".cpp", ".c", ".cs", ".java", ".sh", ".bat", ".sql"],
    "安裝檔 Installers": [".msi", ".iso", ".apk", ".msix"]
  },
  "defaultCategory": "其他 Others",
  "duplicatesFolderName": "重複檔 Duplicates"
}

