<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:PerformanceGuardian.Converters">

  <!-- Converters -->
  <BooleanToVisibilityConverter x:Key="BoolToVis" />
  <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
  <conv:StringEqualityToVisibilityConverter x:Key="PageToVis" />
  <conv:StringEqualityToBoolConverter x:Key="StringEqToBool" />
  <conv:ToneToBackgroundBrushConverter x:Key="ToneToBg" />
  <conv:ToneToForegroundBrushConverter x:Key="ToneToFg" />
  <conv:MetricPercentToBrushConverter x:Key="MetricToBrush" />

  <!-- Core Font Family -->
  <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI, Microsoft JhengHei, sans-serif</FontFamily>

  <!-- Brand & Semantic Color Tokens (Light Default, Dark-ready via DynamicResource) -->
  <Color x:Key="BrandPrimaryColor">#0D9488</Color>
  <Color x:Key="BrandDarkColor">#0F766E</Color>
  <Color x:Key="BrandLightBgColor">#CCFBF1</Color>
  <Color x:Key="StatusWarningColor">#D97706</Color>
  <Color x:Key="StatusErrorColor">#DC2626</Color>

  <SolidColorBrush x:Key="AccentBrush" Color="#0D9488" />
  <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#0D9488" />
  <SolidColorBrush x:Key="BrandDarkBrush" Color="#0F766E" />
  <SolidColorBrush x:Key="BrandLightBgBrush" Color="#CCFBF1" />
  <SolidColorBrush x:Key="BrandSurfaceTintBrush" Color="#F0FDFA" />

  <!-- Override WPF-UI Primary Accent Brushes to Brand Teal (#0D9488 / #0F766E) -->
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0D9488" />
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0F766E" />
  <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#115E59" />
  <SolidColorBrush x:Key="AccentButtonBackground" Color="#0D9488" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0F766E" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#115E59" />
  <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#F0FDFA" />

  <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
  <SolidColorBrush x:Key="WarningSoftBgBrush" Color="#FEF3C7" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
  <SolidColorBrush x:Key="ErrorSoftBgBrush" Color="#FEE2E2" />

  <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#F1F5F9" />
  <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#F8FAFC" />
  <SolidColorBrush x:Key="CardBrush" Color="#F8FAFC" />
  <SolidColorBrush x:Key="ElevatedCardBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F1F5F9" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
  <SolidColorBrush x:Key="DividerBrush" Color="#EAECF0" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
  <SolidColorBrush x:Key="NavActiveBgBrush" Color="#E6FFFA" />

  <!-- Vector Icons (Path Geometry) -->
  <Geometry x:Key="GeoHome">M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z</Geometry>
  <Geometry x:Key="GeoFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</Geometry>
  <Geometry x:Key="GeoPulse">M3,13H7L10,19L14,5L17,13H21</Geometry>
  <Geometry x:Key="GeoHistory">M13,3A9,9 0 0,0 4,12H1L4.89,15.89L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3M12,8V13L16.28,15.54L17,14.33L13.5,12.25V8H12Z</Geometry>
  <Geometry x:Key="GeoSettings">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</Geometry>
  <Geometry x:Key="GeoGuide">M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z</Geometry>
  <Geometry x:Key="GeoShield">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z</Geometry>

  <!-- Accessible Focus Visual -->
  <Style x:Key="FluentFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-2" CornerRadius="10" BorderBrush="{StaticResource BrandPrimaryBrush}" BorderThickness="2" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Card Styles -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource ElevatedCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="SoftCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="AccentBannerStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource BrandSurfaceTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandLightBgBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <!-- Metric ProgressBar Style -->
  <Style x:Key="MetricBarStyle" TargetType="ProgressBar">
    <Setter Property="Height" Value="8" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="Foreground" Value="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource MetricToBrush}, Mode=OneWay}" />
    <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
            <Border x:Name="PART_Track" CornerRadius="4" />
            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
              <Border Background="{TemplateBinding Foreground}" CornerRadius="4" />
            </Decorator>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Left Navigation Sidebar Item Style -->
  <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="RootBorder"
                  Background="{TemplateBinding Background}"
                  CornerRadius="10"
                  Padding="12,0"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="ActiveBar"
                      Width="4" Height="20"
                      CornerRadius="2"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Background="{StaticResource BrandPrimaryBrush}"
                      Visibility="Collapsed" />
              <Path x:Name="NavIcon"
                    Grid.Column="1"
                    Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                    Fill="{TemplateBinding Foreground}"
                    Stretch="Uniform"
                    Width="17" Height="17"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center" />
              <ContentPresenter Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                RecognizesAccessKey="True" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource NavActiveBgBrush}" />
              <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Filter Pill Style (Activity Log & State Preview) -->
  <Style x:Key="FilterPillRadioButtonStyle" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Margin" Value="0,0,8,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="PillBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="18"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="PillBorder" Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
              <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
              <Setter Property="Foreground" Value="#FFFFFF" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Modern Toggle Switch CheckBox Style -->
  <Style x:Key="FluentToggleSwitchStyle" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="SwitchTrack"
                    Width="44" Height="24"
                    CornerRadius="12"
                    Background="#CBD5E1"
                    BorderBrush="#94A3B8"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
              <Border x:Name="SwitchThumb"
                      Width="16" Height="16"
                      CornerRadius="8"
                      Background="#FFFFFF"
                      HorizontalAlignment="Left"
                      Margin="3,0,0,0" />
            </Border>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
              <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource BrandDarkBrush}" />
              <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
