<ui:FluentWindow x:Class="PerformanceGuardian.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Smart Desktop Guardian｜智慧桌面管家"
    Icon="pack://application:,,,/SmartDesktopGuardian;component/Resources/Brand/SmartDesktopGuardian.ico"
    Width="1060" Height="760"
    MinWidth="860" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    FontFamily="{StaticResource AppFontFamily}"
    Background="{DynamicResource WindowSurfaceBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Windows 11 TitleBar -->
    <ui:TitleBar Grid.Row="0" Title="Smart Desktop Guardian｜智慧桌面管家" />

    <!-- Main Shell: Left NavigationView Sidebar + Right Content Area -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="212" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ========================================================= -->
      <!-- Left Fluent Navigation Sidebar                            -->
      <!-- ========================================================= -->
      <Border Grid.Column="0"
              Background="{DynamicResource SidebarSurfaceBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="0,0,1,0"
              Padding="12,12,12,14">
        <DockPanel LastChildFill="True">

          <!-- Brand Identity Header -->
          <Border DockPanel.Dock="Top"
                  Background="{DynamicResource BrandSurfaceTintBrush}"
                  BorderBrush="{DynamicResource BrandLightBgBrush}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="10,9"
                  Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Image Grid.Column="0"
                     Source="pack://application:,,,/SmartDesktopGuardian;component/Resources/Brand/logo-mark.png"
                     Width="34" Height="34"
                     VerticalAlignment="Center"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="智慧桌面管家"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Smart Desktop Guardian"
                           FontSize="10.5"
                           Foreground="{StaticResource BrandDarkBrush}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Sidebar Footer: Live Status + Tray/Exit Actions -->
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8"
                    Margin="0,0,0,8">
              <StackPanel>
                <DockPanel>
                  <Border DockPanel.Dock="Right"
                          CornerRadius="8"
                          Padding="7,2"
                          Background="{Binding OverallSystemStateTone, Converter={StaticResource ToneToBg}}">
                    <TextBlock Text="{Binding OverallSystemStateBadge}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{Binding OverallSystemStateTone, Converter={StaticResource ToneToFg}}" />
                  </Border>
                  <TextBlock Text="守护状态"
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding MonitorBadgeText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:Button Grid.Column="0"
                         Content="收至系统匣"
                         Appearance="Secondary"
                         HorizontalAlignment="Stretch"
                         Padding="4,0"
                         Height="32"
                         FontSize="11.5"
                         ToolTip="最小化至系统匣继续背景守护"
                         Click="MinimizeToTrayButton_Click" />
              <ui:Button Grid.Column="2"
                         Content="完全退出"
                         Appearance="Secondary"
                         HorizontalAlignment="Stretch"
                         Padding="4,0"
                         Height="32"
                         FontSize="11.5"
                         ToolTip="还原暂时设定并完全退出程式"
                         Click="ExitAppButton_Click" />
            </Grid>
          </StackPanel>

          <!-- Navigation Links -->
          <StackPanel>
            <TextBlock Text="功能导航"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="8,0,0,4" />

            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                         Content="首页"
                         Tag="{StaticResource GeoHome}"
                         GroupName="MainNav"
                         AutomationProperties.Name="首页"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource StringEqToBool}, ConverterParameter=Home, Mode=TwoWay}" />

            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                         Content="文件整理"
                         Tag="{StaticResource GeoFolder}"
                         GroupName="MainNav"
                         AutomationProperties.Name="文件整理"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource StringEqToBool}, ConverterParameter=Organizer, Mode=TwoWay}" />

            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                         Content="效能优化"
                         Tag="{StaticResource GeoPulse}"
                         GroupName="MainNav"
                         AutomationProperties.Name="效能优化"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource StringEqToBool}, ConverterParameter=Performance, Mode=TwoWay}" />

            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                         Content="活动纪录"
                         Tag="{StaticResource GeoHistory}"
                         GroupName="MainNav"
                         AutomationProperties.Name="活动纪录"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource StringEqToBool}, ConverterParameter=Activity, Mode=TwoWay}" />

            <Separator Background="{DynamicResource DividerBrush}" Margin="6,8" />

            <TextBlock Text="系统与帮助"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="8,0,0,4" />

            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                         Content="设定"
                         Tag="{StaticResource GeoSettings}"
                         GroupName="MainNav"
                         AutomationProperties.Name="设定"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource StringEqToBool}, ConverterParameter=Settings, Mode=TwoWay}" />

            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                         Content="使用说明"
                         Tag="{StaticResource GeoGuide}"
                         GroupName="MainNav"
                         AutomationProperties.Name="使用说明"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource StringEqToBool}, ConverterParameter=Guide, Mode=TwoWay}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ========================================================= -->
      <!-- Right Content Area (6 Responsive Pages)                   -->
      <!-- ========================================================= -->
      <Grid Grid.Column="1">

        <!-- ======================================================= -->
        <!-- PAGE 1: 首页 (Home)                                     -->
        <!-- ======================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedPage, Converter={StaticResource PageToVis}, ConverterParameter=Home}">
          <StackPanel Margin="20,16,20,22"
                      MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- Page Header -->
            <StackPanel Margin="0,0,0,14">
              <TextBlock Text="电脑与桌面，一处管理"
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextWrapping="Wrap" />
              <TextBlock Text="桌面文书依月份自动归档，并在 8GB RAM／256GB SSD 资源紧张时执行安全、可还原的优先权调度。"
                         FontSize="13"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap"
                         Margin="0,4,0,0" />
            </StackPanel>

            <!-- Overall System Status Banner & 6-State Indicator Bar -->
            <Border Style="{StaticResource AccentBannerStyle}" Padding="14,10" Margin="0,0,0,14">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0"
                          CornerRadius="8"
                          Padding="9,3"
                          VerticalAlignment="Center"
                          Background="{Binding OverallSystemStateTone, Converter={StaticResource ToneToBg}}">
                    <TextBlock Text="{Binding OverallSystemStateBadge}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{Binding OverallSystemStateTone, Converter={StaticResource ToneToFg}}" />
                  </Border>
                  <TextBlock Grid.Column="1"
                             Text="{Binding OverallSystemStateDescription}"
                             FontSize="12.5"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             Margin="10,0,0,0" />
                </Grid>

                <!-- 6 Required System States Visual Selector / Indicator -->
                <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                  <TextBlock Text="状态检视："
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,4" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="即时侦测"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=Auto, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="正常状态"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=正常状态, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="注意状态"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=注意状态, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="高负载状态"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=高负载状态, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="正在处理状态"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=正在处理状态, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="错误状态"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=错误状态, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="尚无资料状态"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=尚无资料状态, Mode=TwoWay}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- Two Main Feature Cards (Document Organizer & Performance Optimization) -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- CARD 1: 文件整理卡片 -->
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                <DockPanel LastChildFill="True">
                  <!-- Card Header -->
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <DockPanel>
                      <Border DockPanel.Dock="Right"
                              CornerRadius="8"
                              Padding="8,2"
                              VerticalAlignment="Center"
                              Background="{Binding OrganizerAutoStateTone, Converter={StaticResource ToneToBg}}">
                        <TextBlock Text="{Binding OrganizerAutoStateBadge}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding OrganizerAutoStateTone, Converter={StaticResource ToneToFg}}" />
                      </Border>
                      <TextBlock Text="桌面文件整理"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="只整理桌面第一层常见办公文书，依最后修改月份归档"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                  </StackPanel>

                  <!-- Bottom Action Buttons -->
                  <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0"
                               Content="立即整理"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Padding="6,0"
                               Height="40"
                               Click="OrganizeNowButton_Click"
                               IsEnabled="{Binding CanOrganize}" />
                    <ui:Button Grid.Column="2"
                               Content="开启整理资料夹"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Padding="6,0"
                               Height="40"
                               Click="OpenOrganizedFolder_Click" />
                  </Grid>

                  <!-- Card Body Metrics -->
                  <StackPanel>
                    <!-- Auto-organize switch row -->
                    <Border Style="{StaticResource SoftCardStyle}" Padding="12,9" Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                          <TextBlock Text="自动整理开关"
                                     FontWeight="SemiBold"
                                     FontSize="13"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                          <TextBlock Text="{Binding OrganizerSummary}"
                                     FontSize="11.5"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     TextWrapping="Wrap"
                                     Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource FluentToggleSwitchStyle}"
                                  Content=""
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="自动整理开关"
                                  IsChecked="{Binding AutoOrganizeEnabled}" />
                      </Grid>
                    </Border>

                    <!-- Key Statistics Rows -->
                    <Border Style="{StaticResource SoftCardStyle}" Padding="12,10">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="8" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="8" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="8" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="最近一次扫描时间" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,8,0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastScanTimeDisplay}" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="今天整理的文件数量" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,8,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TodayOrganizedCountDisplay}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrandDarkBrush}" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="整理资料夹" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,8,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OrganizedFolderNameDisplay}" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding OrganizedPath}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="目前卡片状态" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Border Grid.Row="6" Grid.Column="1" HorizontalAlignment="Right" CornerRadius="6" Padding="7,2"
                                Background="{Binding HomeOrganizerCardStateTone, Converter={StaticResource ToneToBg}}">
                          <TextBlock Text="{Binding HomeOrganizerCardStateBadge}" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{Binding HomeOrganizerCardStateTone, Converter={StaticResource ToneToFg}}" />
                        </Border>
                      </Grid>
                    </Border>
                  </StackPanel>
                </DockPanel>
              </Border>

              <!-- CARD 2: 效能优化卡片 -->
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <DockPanel LastChildFill="True">
                  <!-- Card Header -->
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <DockPanel>
                      <Border DockPanel.Dock="Right"
                              CornerRadius="8"
                              Padding="8,2"
                              VerticalAlignment="Center"
                              Background="{Binding OverallSystemStateTone, Converter={StaticResource ToneToBg}}">
                        <TextBlock Text="{Binding OverallSystemStateBadge}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding OverallSystemStateTone, Converter={StaticResource ToneToFg}}" />
                      </Border>
                      <TextBlock Text="电脑效能优化"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="即时监控核心指标，以可还原的暂时优先权调度缓解卡顿"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                  </StackPanel>

                  <!-- Bottom Action Buttons -->
                  <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0"
                               Content="立即效能急救"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Padding="6,0"
                               Height="40"
                               Click="RescueButton_Click"
                               IsEnabled="{Binding CanRescue}" />
                    <ui:Button Grid.Column="2"
                               Content="{Binding MonitorButtonText}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Padding="6,0"
                               Height="40"
                               Click="MonitorButton_Click" />
                  </Grid>

                  <!-- Card Body Metrics: CPU, RAM, SSD I/O, SSD Free Space, Overall Status -->
                  <Border Style="{StaticResource SoftCardStyle}" Padding="12,10">
                    <StackPanel>
                      <!-- CPU -->
                      <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CpuDisplay}" FontSize="13.5" FontWeight="Bold" />
                        <TextBlock Text="CPU 使用率" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </DockPanel>
                      <ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding CpuPercent, Mode=OneWay}" Margin="0,0,0,8" />

                      <!-- RAM -->
                      <DockPanel Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <TextBlock Text="{Binding AvailableMemoryDisplay}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding MemoryDisplay}" FontSize="13.5" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="RAM 记忆体" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </DockPanel>
                      <ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding MemoryPercent, Mode=OneWay}" Margin="0,0,0,8" />

                      <!-- SSD I/O Pressure -->
                      <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DiskDisplay}" FontSize="13.5" FontWeight="Bold" />
                        <TextBlock Text="SSD I/O 压力" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </DockPanel>
                      <ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding DiskPercent, Mode=OneWay}" Margin="0,0,0,8" />

                      <!-- SSD Free Space & Overall Status -->
                      <Separator Background="{DynamicResource DividerBrush}" Margin="0,2,0,6" />
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="6" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SSD 可用空间" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DiskProfile}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="整体状态" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DockPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- ======================================================= -->
        <!-- PAGE 2: 文件整理 (Document Organizer)                   -->
        <!-- ======================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedPage, Converter={StaticResource PageToVis}, ConverterParameter=Organizer}">
          <StackPanel Margin="20,16,20,22"
                      MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- Header & Auto-Organize Toggle -->
            <DockPanel Margin="0,0,0,14">
              <Border DockPanel.Dock="Right"
                      VerticalAlignment="Top"
                      Background="{DynamicResource ElevatedCardBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="12,7"
                      Margin="12,0,0,0">
                <CheckBox Style="{StaticResource FluentToggleSwitchStyle}"
                          Content="自动整理"
                          FontWeight="SemiBold"
                          IsChecked="{Binding AutoOrganizeEnabled}" />
              </Border>
              <StackPanel>
                <TextBlock Text="桌面文件整理"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="自动扫描桌面第一层常见办公文书，依最后修改时间归档至月份资料夹。"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>

            <!-- Interactive Status Banner (Covers all 10 required interactive states) -->
            <Border Style="{StaticResource AccentBannerStyle}" Padding="14,10" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        CornerRadius="8"
                        Padding="9,4"
                        VerticalAlignment="Center"
                        Background="{Binding OrganizerInteractiveStateTone, Converter={StaticResource ToneToBg}}">
                  <TextBlock Text="{Binding OrganizerInteractiveStateBadge}"
                             FontWeight="Bold"
                             FontSize="12"
                             Foreground="{Binding OrganizerInteractiveStateTone, Converter={StaticResource ToneToFg}}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding OrganizerInteractiveStateDetail}"
                             FontSize="12.5"
                             FontWeight="Medium"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding OrganizerStatus}"
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="2"
                        CornerRadius="8"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Background="{Binding UndoStatusTone, Converter={StaticResource ToneToBg}}">
                  <TextBlock Text="{Binding UndoStatusBadge}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{Binding UndoStatusTone, Converter={StaticResource ToneToFg}}" />
                </Border>
              </Grid>
            </Border>

            <!-- Paths & Timing Configuration Card -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="10" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="12" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="135" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Current Desktop Path -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="当前桌面路径" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DesktopPath}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ui:Button Grid.Row="0" Grid.Column="2" Content="开启桌面" Appearance="Secondary" Height="30" FontSize="12" Margin="8,0,0,0" Click="OpenDesktopFolder_Click" />

                <!-- Current Organized Folder Path -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="当前整理资料夹路径" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrganizedPath}" FontWeight="SemiBold" Foreground="{StaticResource BrandDarkBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ui:Button Grid.Row="2" Grid.Column="2" Content="开启整理资料夹" Appearance="Secondary" Height="30" FontSize="12" Margin="8,0,0,0" Click="OpenOrganizedFolder_Click" />

                <!-- Check Interval & New File Waiting Time -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SoftCardStyle}" Padding="12,8">
                  <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                      <TextBlock Text="检查间隔：" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12.5" />
                      <ComboBox ItemsSource="{Binding ScanIntervalOptions}"
                                SelectedItem="{Binding ScanIntervalMinutes, Mode=TwoWay}"
                                Width="72" Margin="6,0" />
                      <TextBlock Text="分钟" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                      <TextBlock Text="新文件等待时间：" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12.5" />
                      <ComboBox ItemsSource="{Binding NewFileWaitOptions}"
                                SelectedItem="{Binding NewFileWaitMinutes, Mode=TwoWay}"
                                Width="72" Margin="6,0" />
                      <TextBlock Text="分钟（保护刚下载或编辑中档案）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12.5" />
                    </StackPanel>
                  </WrapPanel>
                </Border>
              </Grid>
            </Border>

            <!-- Primary Organizer Action Buttons -->
            <WrapPanel Margin="0,0,0,14">
              <ui:Button Content="立即整理"
                         Appearance="Primary"
                         MinWidth="140"
                         Height="40"
                         Margin="0,0,10,6"
                         Click="OrganizeNowButton_Click"
                         IsEnabled="{Binding CanOrganize}" />
              <ui:Button Content="复原上次整理"
                         Appearance="Secondary"
                         MinWidth="150"
                         Height="40"
                         Margin="0,0,10,6"
                         Click="UndoButton_Click"
                         IsEnabled="{Binding CanOrganize}" />
              <ui:Button Content="开启整理资料夹"
                         Appearance="Secondary"
                         MinWidth="155"
                         Height="40"
                         Margin="0,0,10,6"
                         Click="OpenOrganizedFolder_Click" />
            </WrapPanel>

            <!-- Two-Column Info: Folder Structure Tree + Supported Formats -->
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Folder Hierarchy Tree -->
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                  <TextBlock Text="分类方式" FontSize="15.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <Border Style="{StaticResource SoftCardStyle}" Padding="12,10">
                    <StackPanel TextElement.FontFamily="Consolas, Microsoft JhengHei UI, sans-serif" TextElement.FontSize="12.5">
                      <TextBlock Text="整理 Organized" FontWeight="Bold" Foreground="{StaticResource BrandDarkBrush}" />
                      <TextBlock Text="├── 2026年10月" Margin="0,4,0,0" />
                      <TextBlock Text="├── 2026年11月" Margin="0,4,0,0" />
                      <TextBlock Text="├── 2026年12月" Margin="0,4,0,0" />
                      <TextBlock Text="└── 重複檔 Duplicates" Margin="0,4,0,0" Foreground="#B45309" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                  <TextBlock Text="依档案最后修改时间自动建立年月资料夹；同名且 SHA-256 相同者移入重複檔。"
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             Margin="0,8,0,0" />
                </StackPanel>
              </Border>

              <!-- Supported Formats & Interactive State Guide -->
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                  <TextBlock Text="支援格式（15 种常见办公与文书格式）" FontSize="15.5" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
                  <TextBlock Text="PDF、DOC、DOCX、XLS、XLSX、CSV、PPT、PPTX、TXT、RTF、MD、ODT、ODS、ODP、HWP"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource BrandDarkBrush}"
                             TextWrapping="Wrap"
                             Margin="0,0,0,10" />

                  <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,8" />
                  <TextBlock Text="安全保护与互动状态说明" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <WrapPanel>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#E0F2FE"><TextBlock Text="正在扫描／正在搬移" FontSize="11" Foreground="#0369A1" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#CCFBF1"><TextBlock Text="整理完成" FontSize="11" Foreground="#0F766E" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#FEF3C7"><TextBlock Text="文件正在使用，因此略过" FontSize="11" Foreground="#B45309" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#CCFBF1"><TextBlock Text="同名文件已重新命名" FontSize="11" Foreground="#0F766E" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#FEF3C7"><TextBlock Text="相同内容移入重复档" FontSize="11" Foreground="#B45309" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#F1F5F9"><TextBlock Text="没有可整理文件" FontSize="11" Foreground="#475467" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#CCFBF1"><TextBlock Text="可以复原／没有可复原纪录" FontSize="11" Foreground="#0F766E" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#FEE2E2"><TextBlock Text="整理失败" FontSize="11" Foreground="#B91C1C" /></Border>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Recent Organized Results Table -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock DockPanel.Dock="Right"
                             Text="显示文件类型、名称、原始位置、目的月份、整理时间与状态"
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="最近整理结果" FontSize="16" FontWeight="SemiBold" />
                </DockPanel>

                <!-- Table Column Headers -->
                <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="68" />
                      <ColumnDefinition Width="1.3*" />
                      <ColumnDefinition Width="1.2*" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="115" />
                      <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="文件类型" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="文件名称" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="原始位置" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="目的月份" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="整理时间" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="5" Text="状态" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                  </Grid>
                </Border>

                <!-- Empty State when no items yet -->
                <Border Style="{StaticResource SoftCardStyle}"
                        Visibility="{Binding HasRecentOrganizedItems, Converter={StaticResource InverseBoolToVis}}"
                        Padding="16">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="目前尚无最近整理项目（没有可整理文件或尚未执行整理）"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text="点击上方「立即整理」按钮扫描桌面文书，整理纪录将即时显示于此并支援一键复原。"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                  </StackPanel>
                </Border>

                <!-- Items List -->
                <ItemsControl ItemsSource="{Binding RecentOrganizedItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                        <Grid VerticalAlignment="Center">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="115" />
                            <ColumnDefinition Width="130" />
                          </Grid.ColumnDefinitions>

                          <!-- File Type Icon & Badge -->
                          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileTypeIconGlyph}" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Border Background="{DynamicResource BrandSurfaceTintBrush}" BorderBrush="{DynamicResource BrandLightBgBrush}" BorderThickness="1" CornerRadius="5" Padding="4,1">
                              <TextBlock Text="{Binding FileTypeBadge}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandDarkBrush}" />
                            </Border>
                          </StackPanel>

                          <!-- File Name -->
                          <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" Margin="0,0,6,0" />

                          <!-- Original Location -->
                          <TextBlock Grid.Column="2" Text="{Binding OriginalLocation}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalLocation}" Margin="0,0,6,0" />

                          <!-- Destination Month -->
                          <TextBlock Grid.Column="3" Text="{Binding TargetMonth}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrandDarkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                          <!-- Timestamp -->
                          <TextBlock Grid.Column="4" Text="{Binding OrganizedTime}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                          <!-- Status Badge -->
                          <Border Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="6" Padding="7,2"
                                  Background="{Binding StatusTone, Converter={StaticResource ToneToBg}}">
                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding StatusTone, Converter={StaticResource ToneToFg}}" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ======================================================= -->
        <!-- PAGE 3: 效能优化 (Performance Optimization)             -->
        <!-- ======================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedPage, Converter={StaticResource PageToVis}, ConverterParameter=Performance}">
          <StackPanel Margin="20,16,20,22"
                      MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- Page Header -->
            <DockPanel Margin="0,0,0,14">
              <Border DockPanel.Dock="Right"
                      VerticalAlignment="Top"
                      CornerRadius="10"
                      Padding="10,5"
                      Margin="10,0,0,0"
                      Background="{Binding MonitorBadgeTone, Converter={StaticResource ToneToBg}}">
                <TextBlock Text="{Binding MonitorBadgeText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{Binding MonitorBadgeTone, Converter={StaticResource ToneToFg}}" />
              </Border>
              <StackPanel>
                <TextBlock Text="电脑效能优化"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="专为 8GB RAM 与 256GB SSD 日常办公环境设计，仅执行安全、可随时还原的排程优先权调度。"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>

            <!-- 3 Real-Time Metric Cards: CPU, RAM, SSD -->
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- 1. CPU 使用率 -->
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,2"
                            Background="{Binding CpuStateTone, Converter={StaticResource ToneToBg}}">
                      <TextBlock Text="{Binding CpuStateLabel}" FontSize="10.5" FontWeight="SemiBold"
                                 Foreground="{Binding CpuStateTone, Converter={StaticResource ToneToFg}}" />
                    </Border>
                    <TextBlock Text="CPU 使用率" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBlock Text="{Binding CpuDisplay}" FontSize="28" FontWeight="Bold" Margin="0,6,0,8" />
                  <ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding CpuPercent, Mode=OneWay}" />
                  <TextBlock Text="连续高负载门槛：90%" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- 2. RAM 使用率及可用容量 -->
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,2"
                            Background="{Binding MemoryStateTone, Converter={StaticResource ToneToBg}}">
                      <TextBlock Text="{Binding MemoryStateLabel}" FontSize="10.5" FontWeight="SemiBold"
                                 Foreground="{Binding MemoryStateTone, Converter={StaticResource ToneToFg}}" />
                    </Border>
                    <TextBlock Text="RAM 使用率及可用容量" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBlock Text="{Binding MemoryDisplay}" FontSize="28" FontWeight="Bold" Margin="0,6,0,8" />
                  <ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding MemoryPercent, Mode=OneWay}" />
                  <TextBlock Text="{Binding AvailableMemoryDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrandDarkBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- 3. SSD I/O 压力及剩余空间 -->
              <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,2"
                            Background="{Binding DiskStateTone, Converter={StaticResource ToneToBg}}">
                      <TextBlock Text="{Binding DiskStateLabel}" FontSize="10.5" FontWeight="SemiBold"
                                 Foreground="{Binding DiskStateTone, Converter={StaticResource ToneToFg}}" />
                    </Border>
                    <TextBlock Text="SSD I/O 压力及剩余空间" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBlock Text="{Binding DiskDisplay}" FontSize="28" FontWeight="Bold" Margin="0,6,0,8" />
                  <ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding DiskPercent, Mode=OneWay}" />
                  <TextBlock Text="{Binding DiskFreeDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- Action Controls & Live System Context Card -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
              <StackPanel>
                <WrapPanel Margin="0,0,0,12">
                  <ui:Button Content="立即效能急救"
                             Appearance="Primary"
                             MinWidth="150"
                             Height="40"
                             Margin="0,0,10,6"
                             Click="RescueButton_Click"
                             IsEnabled="{Binding CanRescue}" />
                  <ui:Button Content="{Binding MonitorButtonText}"
                             Appearance="Secondary"
                             MinWidth="165"
                             Height="40"
                             Margin="0,0,10,6"
                             Click="MonitorButton_Click" />
                  <ui:Button Content="还原暂时设定"
                             Appearance="Secondary"
                             MinWidth="145"
                             Height="40"
                             Margin="0,0,10,6"
                             Click="RestoreSettingsButton_Click" />
                </WrapPanel>

                <Border Style="{StaticResource SoftCardStyle}" Padding="14,10">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="135" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="当前前景应用程式" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ForegroundText}" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="最近介入时间" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastInterventionDisplay}" FontWeight="Medium" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="冷却时间" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <WrapPanel Grid.Row="4" Grid.Column="1">
                      <TextBlock Text="{Binding CooldownDisplay}" FontWeight="Medium" />
                      <TextBlock Text="　｜　" Foreground="{DynamicResource TextMutedBrush}" />
                      <TextBlock Text="{Binding PressureSampleDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </WrapPanel>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="当前系统状态" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{StaticResource BrandDarkBrush}" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- Before / After Rescue Intervention Comparison Card -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <Border DockPanel.Dock="Right"
                          CornerRadius="8"
                          Padding="9,3"
                          Background="{Binding RescueImprovementTone, Converter={StaticResource ToneToBg}}">
                    <TextBlock Text="{Binding RescueImprovementBadge}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{Binding RescueImprovementTone, Converter={StaticResource ToneToFg}}" />
                  </Border>
                  <TextBlock Text="效能急救介入前后比较" FontSize="16" FontWeight="SemiBold" />
                </DockPanel>

                <!-- Before -> After Metric Comparison Row -->
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Style="{StaticResource SoftCardStyle}" Padding="12,9">
                    <StackPanel>
                      <TextBlock Text="CPU：介入前 → 介入后" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding RescueCpuComparison}" FontSize="12.5" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Style="{StaticResource SoftCardStyle}" Padding="12,9">
                    <StackPanel>
                      <TextBlock Text="RAM：介入前 → 介入后" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding RescueRamComparison}" FontSize="12.5" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="4" Style="{StaticResource SoftCardStyle}" Padding="12,9">
                    <StackPanel>
                      <TextBlock Text="SSD：介入前 → 介入后" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding RescueSsdComparison}" FontSize="12.5" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- Safe Adjustments & Improvement Analysis -->
                <Border Style="{StaticResource SoftCardStyle}" Padding="12,10">
                  <StackPanel>
                    <TextBlock Text="执行了哪些安全调整：" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding RescueActionsSummary}" FontSize="12.5" FontWeight="Medium" Margin="0,3,0,8" TextWrapping="Wrap" />

                    <TextBlock Text="是否观察到改善与原因说明：" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding RescueNoImprovementReason}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ======================================================= -->
        <!-- PAGE 4: 活动纪录 (Activity Log)                         -->
        <!-- ======================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedPage, Converter={StaticResource PageToVis}, ConverterParameter=Activity}">
          <StackPanel Margin="20,16,20,22"
                      MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- Header -->
            <DockPanel Margin="0,0,0,12">
              <ui:Button DockPanel.Dock="Right"
                         Content="重新整理纪录"
                         Appearance="Secondary"
                         VerticalAlignment="Top"
                         Height="36"
                         Margin="10,0,0,0"
                         Click="RefreshActivityLogButton_Click" />
              <StackPanel>
                <TextBlock Text="活动纪录"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="完整记录桌面文件归档、复原与安全效能调度历程，支援依类别筛选查阅。"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>

            <!-- Privacy Notice Banner (Required exact wording) -->
            <Border Style="{StaticResource AccentBannerStyle}" Padding="14,10" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0"
                      Data="{StaticResource GeoShield}"
                      Fill="{StaticResource BrandPrimaryBrush}"
                      Stretch="Uniform"
                      Width="18" Height="18"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0" />
                <TextBlock Grid.Column="1"
                           Text="活动纪录只保存档案名称、路径、操作结果及效能指标，不读取或上传文件内容。"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrandDarkBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </Grid>
            </Border>

            <!-- Filter Bar: 全部 / 文件整理 / 效能优化 / 警告 / 错误 + Search -->
            <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,14">
              <DockPanel>
                <TextBox DockPanel.Dock="Right"
                         Width="170"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Margin="8,0,0,0"
                         ToolTip="输入关键字筛选档案名称或动作"
                         Text="{Binding ActivitySearchText, UpdateSourceTrigger=PropertyChanged}" />
                <WrapPanel VerticalAlignment="Center">
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="全部"
                               GroupName="ActivityFilterGroup"
                               IsChecked="{Binding SelectedActivityFilter, Converter={StaticResource StringEqToBool}, ConverterParameter=全部, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="文件整理"
                               GroupName="ActivityFilterGroup"
                               IsChecked="{Binding SelectedActivityFilter, Converter={StaticResource StringEqToBool}, ConverterParameter=文件整理, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="效能优化"
                               GroupName="ActivityFilterGroup"
                               IsChecked="{Binding SelectedActivityFilter, Converter={StaticResource StringEqToBool}, ConverterParameter=效能优化, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="警告"
                               GroupName="ActivityFilterGroup"
                               IsChecked="{Binding SelectedActivityFilter, Converter={StaticResource StringEqToBool}, ConverterParameter=警告, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="错误"
                               GroupName="ActivityFilterGroup"
                               IsChecked="{Binding SelectedActivityFilter, Converter={StaticResource StringEqToBool}, ConverterParameter=错误, Mode=TwoWay}" />
                </WrapPanel>
              </DockPanel>
            </Border>

            <!-- Activity Log Table Card -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding ActivityCountSummary}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="操作与调度明细" FontSize="15.5" FontWeight="SemiBold" />
                </DockPanel>

                <!-- Table Header: 时间 / 类别 / 动作 / 对象 / 执行结果 -->
                <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="135" />
                      <ColumnDefinition Width="84" />
                      <ColumnDefinition Width="115" />
                      <ColumnDefinition Width="1.1*" />
                      <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="时间" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="类别" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="动作" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="对象" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="执行结果" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Grid>
                </Border>

                <!-- Empty State -->
                <Border Style="{StaticResource SoftCardStyle}"
                        Visibility="{Binding HasFilteredActivityItems, Converter={StaticResource InverseBoolToVis}}"
                        Padding="18">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="目前筛选条件下尚无活动纪录"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="当您执行「立即整理」、「复原上次整理」或「立即效能急救」后，纪录将即时列于此处。"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                  </StackPanel>
                </Border>

                <!-- Activity Rows -->
                <ItemsControl ItemsSource="{Binding FilteredActivityItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                        <Grid VerticalAlignment="Center">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="115" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.5*" />
                          </Grid.ColumnDefinitions>

                          <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                          <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="6" Padding="7,2"
                                  Background="{Binding StatusTone, Converter={StaticResource ToneToBg}}">
                            <TextBlock Text="{Binding CategoryDisplay}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding StatusTone, Converter={StaticResource ToneToFg}}" />
                          </Border>

                          <TextBlock Grid.Column="2" Text="{Binding ActionDisplay}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="Wrap" />

                          <TextBlock Grid.Column="3" Text="{Binding TargetDisplay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetDisplay}" />

                          <TextBlock Grid.Column="4" Text="{Binding ResultDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ======================================================= -->
        <!-- PAGE 5: 设定 (Settings)                                 -->
        <!-- ======================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedPage, Converter={StaticResource PageToVis}, ConverterParameter=Settings}">
          <StackPanel Margin="20,16,20,22"
                      MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <TextBlock Text="系统与偏好设定"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="调整桌面文件自动整理规则、背景智慧效能监控门槛及一般外观偏好。"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,14" />

            <!-- SECTION 1: 文件整理设定 -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="文件整理设定" FontSize="16.5" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- 自动整理 -->
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="自动整理" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding AutoOrganizeEnabled}">
                    <TextBlock Text="定期自动扫描并归档桌面第一层文书" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- 检查间隔 -->
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="检查间隔" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding ScanIntervalOptions}" SelectedItem="{Binding ScanIntervalMinutes, Mode=TwoWay}" Width="82" />
                    <TextBlock Text="分钟（预设 15 分钟）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>

                  <!-- 新文件等待时间 -->
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="新文件等待时间" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding NewFileWaitOptions}" SelectedItem="{Binding NewFileWaitMinutes, Mode=TwoWay}" Width="82" />
                    <TextBlock Text="分钟（预设 60 分钟，避免搬移刚下载或编辑中的文件）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                  </WrapPanel>

                  <!-- 整理资料夹 -->
                  <TextBlock Grid.Row="6" Grid.Column="0" Text="整理资料夹" FontWeight="Medium" VerticalAlignment="Center" />
                  <DockPanel Grid.Row="6" Grid.Column="1">
                    <ui:Button DockPanel.Dock="Right" Content="开启整理资料夹" Appearance="Secondary" Height="30" FontSize="12" Margin="8,0,0,0" Click="OpenOrganizedFolder_Click" />
                    <TextBox Text="{Binding OrganizedFolderName, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" Height="30" Padding="8,0" />
                  </DockPanel>

                  <!-- 重复档识别 -->
                  <TextBlock Grid.Row="8" Grid.Column="0" Text="重复档识别" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding DuplicateCheckEnabled}">
                    <TextBlock Text="同名档案以 SHA-256 比对内容；相同内容移入「重複檔 Duplicates」" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- 复原纪录 -->
                  <TextBlock Grid.Row="10" Grid.Column="0" Text="复原纪录" FontWeight="Medium" VerticalAlignment="Center" />
                  <DockPanel Grid.Row="10" Grid.Column="1">
                    <ui:Button DockPanel.Dock="Right" Content="复原上次整理" Appearance="Secondary" Height="30" FontSize="12" Margin="8,0,0,0" Click="UndoButton_Click" IsEnabled="{Binding CanOrganize}" />
                    <TextBlock Text="{Binding UndoStatusBadge}" VerticalAlignment="Center" Foreground="{StaticResource BrandDarkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </DockPanel>
                </Grid>

                <!-- 文件格式 (15 supported extensions) -->
                <Separator Background="{DynamicResource DividerBrush}" Margin="0,12,0,10" />
                <DockPanel Margin="0,0,0,8">
                  <ui:Button DockPanel.Dock="Right" Content="恢复预设 15 种格式" Appearance="Secondary" Height="28" FontSize="11.5" Click="ResetDefaultFormatsButton_Click" />
                  <TextBlock Text="文件格式（勾选要纳入自动整理的文书副档名）" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding FormatChips}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,6,6">
                        <CheckBox Content="{Binding DisplayLabel}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- SECTION 2: 效能设定 -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="效能设定" FontSize="16.5" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- 背景监控 -->
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="背景监控" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding BackgroundMonitoringEnabled}">
                    <TextBlock Text="启动低频背景智慧监控（连续压力达标才自动调度）" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- 监控间隔 -->
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="监控间隔" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding MonitorIntervalOptions}" SelectedItem="{Binding MonitorIntervalSeconds, Mode=TwoWay}" Width="82" />
                    <TextBlock Text="秒（预设 5 秒低开销取样）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>

                  <!-- 连续压力触发次数 -->
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="连续压力触发次数" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding PressureTriggerOptions}" SelectedItem="{Binding PressureTriggerCount, Mode=TwoWay}" Width="82" />
                    <TextBlock Text="次（预设连续 3 次达标才介入）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>

                  <!-- 冷却时间 -->
                  <TextBlock Grid.Row="6" Grid.Column="0" Text="冷却时间" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="6" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding CooldownMinuteOptions}" SelectedItem="{Binding CooldownMinutes, Mode=TwoWay}" Width="82" />
                    <TextBlock Text="分钟（预设 5 分钟，避免频繁重复介入）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>

                  <!-- 停止时自动还原 -->
                  <TextBlock Grid.Row="8" Grid.Column="0" Text="停止时自动还原" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding AutoRestoreOnStop}">
                    <TextBlock Text="停止背景监控或退出程式时，自动还原所有暂时优先权调整" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- SSD 空间警告门槛 -->
                  <TextBlock Grid.Row="10" Grid.Column="0" Text="SSD 空间警告门槛" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="10" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding SsdThresholdOptions}" SelectedItem="{Binding SsdWarningThresholdPercent, Mode=TwoWay}" Width="82" />
                    <TextBlock Text="%（预设低于 15% 时提醒保留可用空间）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- SECTION 3: 一般设定 -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
              <StackPanel>
                <TextBlock Text="一般设定" FontSize="16.5" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- 随 Windows 登录启动 -->
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="随 Windows 登录启动" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding LaunchAtLoginPreference}">
                    <TextBlock Text="记住登录启动偏好（可由安装程序设定随 Windows 登录自动启动）" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- 启动后最小化 -->
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="启动后最小化" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding StartMinimizedPreference}">
                    <TextBlock Text="程式启动时自动最小化视窗，不打扰日常办公" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- 关闭视窗后留在系统匣 -->
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="关闭视窗后留在系统匣" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding MinimizeToTrayOnClose}">
                    <TextBlock Text="点击右上角关闭按钮时最小化至系统匣继续守护" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- 主题 -->
                  <TextBlock Grid.Row="6" Grid.Column="0" Text="主题" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="6" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}" Width="110" />
                    <TextBlock Text="（Light 浅色主题为主，支援 Dark 深色主题）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>

                  <!-- 语言 -->
                  <TextBlock Grid.Row="8" Grid.Column="0" Text="语言" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="8" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguageMode, Mode=TwoWay}" Width="110" />
                    <TextBlock Text="（繁体中文／中文介面）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>

                  <!-- 开启日志资料夹 -->
                  <TextBlock Grid.Row="10" Grid.Column="0" Text="开启日志资料夹" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="10" Grid.Column="1" VerticalAlignment="Center">
                    <ui:Button Content="开启日志资料夹" Appearance="Secondary" Height="32" FontSize="12" Click="OpenLogFolder_Click" />
                    <TextBlock Text="{Binding DataDirectoryDisplay}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                  </WrapPanel>

                  <!-- 版本资讯 -->
                  <TextBlock Grid.Row="12" Grid.Column="0" Text="版本资讯" FontWeight="Medium" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding AppVersionDisplay}" FontWeight="SemiBold" Foreground="{StaticResource BrandDarkBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ======================================================= -->
        <!-- PAGE 6: 使用说明 (User Guide & Dynamic Paths)           -->
        <!-- ======================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedPage, Converter={StaticResource PageToVis}, ConverterParameter=Guide}">
          <StackPanel Margin="20,16,20,22"
                      MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- Brand Banner Header -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="16,12">
              <DockPanel>
                <ui:Button DockPanel.Dock="Right"
                           Content="重新产生说明书"
                           Appearance="Primary"
                           VerticalAlignment="Center"
                           Height="38"
                           Margin="12,0,0,0"
                           Click="GenerateManualButton_Click" />
                <Image Source="pack://application:,,,/SmartDesktopGuardian;component/Resources/Brand/logo-full-light.png"
                       Height="68"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality" />
              </DockPanel>
            </Border>

            <!-- Dynamic Portable Paths Card (5 Required Paths) -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock DockPanel.Dock="Right"
                             Text="依目前执行环境与登入使用者自动侦测"
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="动态可携式路径资讯" FontSize="16.5" FontWeight="SemiBold" />
                </DockPanel>

                <Border Style="{StaticResource SoftCardStyle}" Padding="14,12">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="145" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="当前安装路径" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstallPathDisplay}" FontFamily="Consolas, Microsoft JhengHei UI" FontSize="12" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="当前桌面路径" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DesktopPath}" FontFamily="Consolas, Microsoft JhengHei UI" FontSize="12" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="当前整理资料夹路径" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OrganizedPath}" FontFamily="Consolas, Microsoft JhengHei UI" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandDarkBrush}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="设定档路径" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SettingsFilePathDisplay}" FontFamily="Consolas, Microsoft JhengHei UI" FontSize="12" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="日志路径" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding LogFilePathDisplay}" FontFamily="Consolas, Microsoft JhengHei UI" FontSize="12" TextWrapping="Wrap" />
                  </Grid>
                </Border>

                <WrapPanel Margin="0,10,0,0">
                  <ui:Button Content="重新产生说明书" Appearance="Secondary" Height="34" FontSize="12" Margin="0,0,8,0" Click="GenerateManualButton_Click" />
                  <ui:Button Content="开启整理资料夹" Appearance="Secondary" Height="34" FontSize="12" Margin="0,0,8,0" Click="OpenOrganizedFolder_Click" />
                  <ui:Button Content="开启日志资料夹" Appearance="Secondary" Height="34" FontSize="12" Click="OpenLogFolder_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- Guide Cards: Rules & Safety Principles -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                  <TextBlock Text="一、桌面文件整理说明" FontSize="15.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <TextBlock Text="• 只检查目前使用者桌面第一层，绝不移动资料夹、捷径 (.lnk)、图片、影音或应用程式执行档。" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" />
                  <TextBlock Text="• 依档案最后修改时间自动归档至「整理 Organized\yyyy年MM月」资料夹。" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" />
                  <TextBlock Text="• 正在开启或编辑中的文件会自动略过；同名但内容不同者自动加序号保留；SHA-256 相同内容者移入「重複檔 Duplicates」。" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" />
                  <TextBlock Text="• 保留最近 100 批整理纪录，随时可点击「复原上次整理」将档案放回桌面。" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrandDarkBrush}" FontWeight="Medium" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                  <TextBlock Text="二、安全效能守护说明" FontSize="15.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <TextBlock Text="• 专为 8GB RAM、256GB SSD 办公电脑最佳化，即时监控 CPU、记忆体与磁碟 I/O 压力。" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" />
                  <TextBlock Text="• 仅对非前景且长时间高耗能的背景程式暂时调降排程优先权，并提升目前前景程式反应流畅度。" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" />
                  <TextBlock Text="• 严格安全承诺：绝不强制关闭应用程式、不清空 Windows Standby 快取、不停用 Pagefile 或系统服务。" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" />
                  <TextBlock Text="• 所有优先权调整皆为暂时性，停止监控或点击「还原暂时设定」即可立即恢复。" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrandDarkBrush}" FontWeight="Medium" />
                </StackPanel>
              </Border>
            </Grid>

          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
