<ui:FluentWindow x:Class="PerformanceGuardian.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Smart Desktop Guardian｜智慧桌面管家"
    Icon="pack://application:,,,/SmartDesktopGuardian;component/Resources/Brand/SmartDesktopGuardian.ico"
    Width="1060" Height="760"
    MinWidth="860" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    FontFamily="{StaticResource AppFontFamily}"
    Background="{DynamicResource WindowSurfaceBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Windows 11 TitleBar -->
    <ui:TitleBar Grid.Row="0" Title="Smart Desktop Guardian｜智慧桌面管家" />

    <!-- Main Shell: Left NavigationView Sidebar + Right Content Area -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="212" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ========================================================= -->
      <!-- Left Fluent Navigation Sidebar                            -->
      <!-- ========================================================= -->
      <Border Grid.Column="0"
              Background="{DynamicResource SidebarSurfaceBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="0,0,1,0"
              Padding="12,12,12,14">
        <DockPanel LastChildFill="True">

          <!-- Brand Identity Header -->
          <Border DockPanel.Dock="Top"
                  Background="{DynamicResource BrandSurfaceTintBrush}"
                  BorderBrush="{DynamicResource BrandLightBgBrush}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="10,9"
                  Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Image Grid.Column="0"
                     Source="pack://application:,,,/SmartDesktopGuardian;component/Resources/Brand/logo-mark.png"
                     Width="34" Height="34"
                     VerticalAlignment="Center"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="智慧桌面管家"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Smart Desktop Guardian"
                           FontSize="10.5"
                           Foreground="{StaticResource BrandDarkBrush}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Sidebar Footer: Live Status + Tray/Exit Actions -->
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8"
                    Margin="0,0,0,8">
              <StackPanel>
                <DockPanel>
                  <Border DockPanel.Dock="Right"
                          CornerRadius="8"
                          Padding="7,2"
                          Background="{Binding OverallSystemStateTone, Converter={StaticResource ToneToBg}}">
                    <TextBlock Text="{Binding OverallSystemStateBadge}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{Binding OverallSystemStateTone, Converter={StaticResource ToneToFg}}" />
                  </Border>
                  <TextBlock Text="守護狀態"
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding MonitorBadgeText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:Button Grid.Column="0"
                         Content="收至系統匣"
                         Appearance="Secondary"
                         HorizontalAlignment="Stretch"
                         Padding="4,0"
                         Height="32"
                         FontSize="11.5"
                         ToolTip="最小化至系統匣繼續背景守護"
                         Click="MinimizeToTrayButton_Click" />
              <ui:Button Grid.Column="2"
                         Content="完全退出"
                         Appearance="Secondary"
                         HorizontalAlignment="Stretch"
                         Padding="4,0"
                         Height="32"
                         FontSize="11.5"
                         ToolTip="還原暫時設定並完全退出程式"
                         Click="ExitAppButton_Click" />
            </Grid>
          </StackPanel>

          <!-- Navigation Links -->
          <StackPanel>
            <TextBlock Text="功能導航"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="8,0,0,4" />

            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                         Content="首頁"
                         Tag="{StaticResource GeoHome}"
                         GroupName="MainNav"
                         AutomationProperties.Name="首頁"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource StringEqToBool}, ConverterParameter=Home, Mode=TwoWay}" />

            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                         Content="文件整理"
                         Tag="{StaticResource GeoFolder}"
                         GroupName="MainNav"
                         AutomationProperties.Name="文件整理"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource StringEqToBool}, ConverterParameter=Organizer, Mode=TwoWay}" />

            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                         Content="效能優化"
                         Tag="{StaticResource GeoPulse}"
                         GroupName="MainNav"
                         AutomationProperties.Name="效能優化"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource StringEqToBool}, ConverterParameter=Performance, Mode=TwoWay}" />

            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                         Content="活動紀錄"
                         Tag="{StaticResource GeoHistory}"
                         GroupName="MainNav"
                         AutomationProperties.Name="活動紀錄"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource StringEqToBool}, ConverterParameter=Activity, Mode=TwoWay}" />

            <Separator Background="{DynamicResource DividerBrush}" Margin="6,8" />

            <TextBlock Text="系統與說明"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="8,0,0,4" />

            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                         Content="設定"
                         Tag="{StaticResource GeoSettings}"
                         GroupName="MainNav"
                         AutomationProperties.Name="設定"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource StringEqToBool}, ConverterParameter=Settings, Mode=TwoWay}" />

            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                         Content="使用說明"
                         Tag="{StaticResource GeoGuide}"
                         GroupName="MainNav"
                         AutomationProperties.Name="使用說明"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource StringEqToBool}, ConverterParameter=Guide, Mode=TwoWay}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ========================================================= -->
      <!-- Right Content Area (6 Responsive Pages)                   -->
      <!-- ========================================================= -->
      <Grid Grid.Column="1">

        <!-- ======================================================= -->
        <!-- PAGE 1: 首頁 (Home)                                     -->
        <!-- ======================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedPage, Converter={StaticResource PageToVis}, ConverterParameter=Home}">
          <StackPanel Margin="20,16,20,22"
                      MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- Page Header -->
            <StackPanel Margin="0,0,0,14">
              <TextBlock Text="電腦與桌面，一處管理"
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextWrapping="Wrap" />
              <TextBlock Text="桌面文書依月份自動歸檔，並在 8GB RAM／256GB SSD 資源緊張時執行安全、可還原的優先權調度。"
                         FontSize="13"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap"
                         Margin="0,4,0,0" />
            </StackPanel>

            <!-- Overall System Status Banner & 6-State Indicator Bar -->
            <Border Style="{StaticResource AccentBannerStyle}" Padding="14,10" Margin="0,0,0,14">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0"
                          CornerRadius="8"
                          Padding="9,3"
                          VerticalAlignment="Center"
                          Background="{Binding OverallSystemStateTone, Converter={StaticResource ToneToBg}}">
                    <TextBlock Text="{Binding OverallSystemStateBadge}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{Binding OverallSystemStateTone, Converter={StaticResource ToneToFg}}" />
                  </Border>
                  <TextBlock Grid.Column="1"
                             Text="{Binding OverallSystemStateDescription}"
                             FontSize="12.5"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             Margin="10,0,0,0" />
                </Grid>

                <!-- 6 Required System States Visual Selector / Indicator -->
                <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                  <TextBlock Text="狀態檢視："
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,4" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="即時偵測"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=Auto, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="正常狀態"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=正常狀態, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="注意狀態"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=注意狀態, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="高負載狀態"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=高負載狀態, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="正在處理狀態"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=正在處理狀態, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="錯誤狀態"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=錯誤狀態, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="尚無資料狀態"
                               Padding="9,3" Margin="0,0,6,4" FontSize="11"
                               GroupName="HomeStatePreview"
                               IsChecked="{Binding SelectedHomeStatePreview, Converter={StaticResource StringEqToBool}, ConverterParameter=尚無資料狀態, Mode=TwoWay}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- Two Main Feature Cards (Document Organizer & Performance Optimization) -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- CARD 1: 文件整理卡片 -->
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                <DockPanel LastChildFill="True">
                  <!-- Card Header -->
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <DockPanel>
                      <Border DockPanel.Dock="Right"
                              CornerRadius="8"
                              Padding="8,2"
                              VerticalAlignment="Center"
                              Background="{Binding OrganizerAutoStateTone, Converter={StaticResource ToneToBg}}">
                        <TextBlock Text="{Binding OrganizerAutoStateBadge}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding OrganizerAutoStateTone, Converter={StaticResource ToneToFg}}" />
                      </Border>
                      <TextBlock Text="桌面文件整理"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="只整理桌面第一層常見辦公文書，依最後修改月份歸檔"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                  </StackPanel>

                  <!-- Bottom Action Buttons -->
                  <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0"
                               Content="立即整理"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Padding="6,0"
                               Height="40"
                               Click="OrganizeNowButton_Click"
                               IsEnabled="{Binding CanOrganize}" />
                    <ui:Button Grid.Column="2"
                               Content="開啟整理資料夾"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Padding="6,0"
                               Height="40"
                               Click="OpenOrganizedFolder_Click" />
                  </Grid>

                  <!-- Card Body Metrics -->
                  <StackPanel>
                    <!-- Auto-organize switch row -->
                    <Border Style="{StaticResource SoftCardStyle}" Padding="12,9" Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                          <TextBlock Text="自動整理開關"
                                     FontWeight="SemiBold"
                                     FontSize="13"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                          <TextBlock Text="{Binding OrganizerSummary}"
                                     FontSize="11.5"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     TextWrapping="Wrap"
                                     Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource FluentToggleSwitchStyle}"
                                  Content=""
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="自動整理開關"
                                  IsChecked="{Binding AutoOrganizeEnabled}" />
                      </Grid>
                    </Border>

                    <!-- Key Statistics Rows -->
                    <Border Style="{StaticResource SoftCardStyle}" Padding="12,10">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="8" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="8" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="8" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="最近一次掃描時間" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,8,0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastScanTimeDisplay}" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="今天整理的文件數量" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,8,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TodayOrganizedCountDisplay}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrandDarkBrush}" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="整理資料夾" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,8,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OrganizedFolderNameDisplay}" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding OrganizedPath}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="目前卡片狀態" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Border Grid.Row="6" Grid.Column="1" HorizontalAlignment="Right" CornerRadius="6" Padding="7,2"
                                Background="{Binding HomeOrganizerCardStateTone, Converter={StaticResource ToneToBg}}">
                          <TextBlock Text="{Binding HomeOrganizerCardStateBadge}" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{Binding HomeOrganizerCardStateTone, Converter={StaticResource ToneToFg}}" />
                        </Border>
                      </Grid>
                    </Border>
                  </StackPanel>
                </DockPanel>
              </Border>

              <!-- CARD 2: 效能優化卡片 -->
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <DockPanel LastChildFill="True">
                  <!-- Card Header -->
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <DockPanel>
                      <Border DockPanel.Dock="Right"
                              CornerRadius="8"
                              Padding="8,2"
                              VerticalAlignment="Center"
                              Background="{Binding OverallSystemStateTone, Converter={StaticResource ToneToBg}}">
                        <TextBlock Text="{Binding OverallSystemStateBadge}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding OverallSystemStateTone, Converter={StaticResource ToneToFg}}" />
                      </Border>
                      <TextBlock Text="電腦效能優化"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="即時監控核心指標，以可還原的暫時優先權調度緩解卡頓"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                  </StackPanel>

                  <!-- Bottom Action Buttons -->
                  <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0"
                               Content="立即效能急救"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Padding="6,0"
                               Height="40"
                               Click="RescueButton_Click"
                               IsEnabled="{Binding CanRescue}" />
                    <ui:Button Grid.Column="2"
                               Content="{Binding MonitorButtonText}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Padding="6,0"
                               Height="40"
                               Click="MonitorButton_Click" />
                  </Grid>

                  <!-- Card Body Metrics: CPU, RAM, SSD I/O, SSD Free Space, Overall Status -->
                  <Border Style="{StaticResource SoftCardStyle}" Padding="12,10">
                    <StackPanel>
                      <!-- CPU -->
                      <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CpuDisplay}" FontSize="13.5" FontWeight="Bold" />
                        <TextBlock Text="CPU 使用率" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </DockPanel>
                      <ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding CpuPercent, Mode=OneWay}" Margin="0,0,0,8" />

                      <!-- RAM -->
                      <DockPanel Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <TextBlock Text="{Binding AvailableMemoryDisplay}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding MemoryDisplay}" FontSize="13.5" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="RAM 記憶體" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </DockPanel>
                      <ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding MemoryPercent, Mode=OneWay}" Margin="0,0,0,8" />

                      <!-- SSD I/O Pressure -->
                      <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DiskDisplay}" FontSize="13.5" FontWeight="Bold" />
                        <TextBlock Text="SSD I/O 壓力" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </DockPanel>
                      <ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding DiskPercent, Mode=OneWay}" Margin="0,0,0,8" />

                      <!-- SSD Free Space & Overall Status -->
                      <Separator Background="{DynamicResource DividerBrush}" Margin="0,2,0,6" />
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="6" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SSD 可用空間" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DiskProfile}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="整體狀態" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DockPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- ======================================================= -->
        <!-- PAGE 2: 文件整理 (Document Organizer)                   -->
        <!-- ======================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedPage, Converter={StaticResource PageToVis}, ConverterParameter=Organizer}">
          <StackPanel Margin="20,16,20,22"
                      MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- Header & Auto-Organize Toggle -->
            <DockPanel Margin="0,0,0,14">
              <Border DockPanel.Dock="Right"
                      VerticalAlignment="Top"
                      Background="{DynamicResource ElevatedCardBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="12,7"
                      Margin="12,0,0,0">
                <CheckBox Style="{StaticResource FluentToggleSwitchStyle}"
                          Content="自動整理"
                          FontWeight="SemiBold"
                          IsChecked="{Binding AutoOrganizeEnabled}" />
              </Border>
              <StackPanel>
                <TextBlock Text="桌面文件整理"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="自動掃描桌面第一層常見辦公文書，依最後修改時間歸檔至月份資料夾。"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>

            <!-- Interactive Status Banner (Covers all 10 required interactive states) -->
            <Border Style="{StaticResource AccentBannerStyle}" Padding="14,10" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        CornerRadius="8"
                        Padding="9,4"
                        VerticalAlignment="Center"
                        Background="{Binding OrganizerInteractiveStateTone, Converter={StaticResource ToneToBg}}">
                  <TextBlock Text="{Binding OrganizerInteractiveStateBadge}"
                             FontWeight="Bold"
                             FontSize="12"
                             Foreground="{Binding OrganizerInteractiveStateTone, Converter={StaticResource ToneToFg}}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding OrganizerInteractiveStateDetail}"
                             FontSize="12.5"
                             FontWeight="Medium"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding OrganizerStatus}"
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="2"
                        CornerRadius="8"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Background="{Binding UndoStatusTone, Converter={StaticResource ToneToBg}}">
                  <TextBlock Text="{Binding UndoStatusBadge}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{Binding UndoStatusTone, Converter={StaticResource ToneToFg}}" />
                </Border>
              </Grid>
            </Border>

            <!-- Paths & Timing Configuration Card -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="10" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="12" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Current Desktop Path -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="當前桌面路徑" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DesktopPath}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ui:Button Grid.Row="0" Grid.Column="2" Content="開啟桌面" Appearance="Secondary" Height="30" FontSize="12" Margin="8,0,0,0" Click="OpenDesktopFolder_Click" />

                <!-- Current Organized Folder Path -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="當前整理資料夾路徑" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrganizedPath}" FontWeight="SemiBold" Foreground="{StaticResource BrandDarkBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ui:Button Grid.Row="2" Grid.Column="2" Content="開啟整理資料夾" Appearance="Secondary" Height="30" FontSize="12" Margin="8,0,0,0" Click="OpenOrganizedFolder_Click" />

                <!-- Check Interval & New File Waiting Time -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SoftCardStyle}" Padding="12,8">
                  <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                      <TextBlock Text="檢查間隔：" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12.5" />
                      <ComboBox ItemsSource="{Binding ScanIntervalOptions}"
                                SelectedItem="{Binding ScanIntervalMinutes, Mode=TwoWay}"
                                Width="72" Margin="6,0" />
                      <TextBlock Text="分鐘" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                      <TextBlock Text="新文件等待時間：" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12.5" />
                      <ComboBox ItemsSource="{Binding NewFileWaitOptions}"
                                SelectedItem="{Binding NewFileWaitMinutes, Mode=TwoWay}"
                                Width="72" Margin="6,0" />
                      <TextBlock Text="分鐘（保護剛下載或編輯中檔案）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12.5" />
                    </StackPanel>
                  </WrapPanel>
                </Border>
              </Grid>
            </Border>

            <!-- Primary Organizer Action Buttons -->
            <WrapPanel Margin="0,0,0,14">
              <ui:Button Content="立即整理"
                         Appearance="Primary"
                         MinWidth="140"
                         Height="40"
                         Margin="0,0,10,6"
                         Click="OrganizeNowButton_Click"
                         IsEnabled="{Binding CanOrganize}" />
              <ui:Button Content="復原上次整理"
                         Appearance="Secondary"
                         MinWidth="150"
                         Height="40"
                         Margin="0,0,10,6"
                         Click="UndoButton_Click"
                         IsEnabled="{Binding CanOrganize}" />
              <ui:Button Content="開啟整理資料夾"
                         Appearance="Secondary"
                         MinWidth="155"
                         Height="40"
                         Margin="0,0,10,6"
                         Click="OpenOrganizedFolder_Click" />
            </WrapPanel>

            <!-- Two-Column Info: Folder Structure Tree + Supported Formats -->
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Folder Hierarchy Tree -->
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                  <TextBlock Text="分類方式" FontSize="15.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <Border Style="{StaticResource SoftCardStyle}" Padding="12,10">
                    <StackPanel TextElement.FontFamily="Consolas, Microsoft JhengHei UI, sans-serif" TextElement.FontSize="12.5">
                      <TextBlock Text="整理 Organized" FontWeight="Bold" Foreground="{StaticResource BrandDarkBrush}" />
                      <TextBlock Text="├── 2026年10月" Margin="0,4,0,0" />
                      <TextBlock Text="├── 2026年11月" Margin="0,4,0,0" />
                      <TextBlock Text="├── 2026年12月" Margin="0,4,0,0" />
                      <TextBlock Text="└── 重複檔 Duplicates" Margin="0,4,0,0" Foreground="#B45309" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                  <TextBlock Text="依檔案最後修改時間自動建立年月資料夾；同名且 SHA-256 相同者移入重複檔。"
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             Margin="0,8,0,0" />
                </StackPanel>
              </Border>

              <!-- Supported Formats & Interactive State Guide -->
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                  <TextBlock Text="支援格式（15 種常見辦公與文書格式）" FontSize="15.5" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
                  <TextBlock Text="PDF、DOC、DOCX、XLS、XLSX、CSV、PPT、PPTX、TXT、RTF、MD、ODT、ODS、ODP、HWP"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource BrandDarkBrush}"
                             TextWrapping="Wrap"
                             Margin="0,0,0,10" />

                  <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,8" />
                  <TextBlock Text="安全保護與互動狀態說明" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <WrapPanel>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#E0F2FE"><TextBlock Text="正在掃描／正在搬移" FontSize="11" Foreground="#0369A1" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#CCFBF1"><TextBlock Text="整理完成" FontSize="11" Foreground="#0F766E" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#FEF3C7"><TextBlock Text="文件正在使用，因此略過" FontSize="11" Foreground="#B45309" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#CCFBF1"><TextBlock Text="同名文件已重新命名" FontSize="11" Foreground="#0F766E" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#FEF3C7"><TextBlock Text="相同內容移入重複檔" FontSize="11" Foreground="#B45309" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#F1F5F9"><TextBlock Text="沒有可整理文件" FontSize="11" Foreground="#475467" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#CCFBF1"><TextBlock Text="可以復原／沒有可復原紀錄" FontSize="11" Foreground="#0F766E" /></Border>
                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,6" Background="#FEE2E2"><TextBlock Text="整理失敗" FontSize="11" Foreground="#B91C1C" /></Border>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Recent Organized Results Table -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock DockPanel.Dock="Right"
                             Text="顯示文件類型、名稱、原始位置、目的月份、整理時間與狀態"
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="最近整理結果" FontSize="16" FontWeight="SemiBold" />
                </DockPanel>

                <!-- Table Column Headers -->
                <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="68" />
                      <ColumnDefinition Width="1.3*" />
                      <ColumnDefinition Width="1.2*" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="115" />
                      <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="文件類型" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="文件名稱" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="原始位置" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="目的月份" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="整理時間" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="5" Text="狀態" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                  </Grid>
                </Border>

                <!-- Empty State when no items yet -->
                <Border Style="{StaticResource SoftCardStyle}"
                        Visibility="{Binding HasRecentOrganizedItems, Converter={StaticResource InverseBoolToVis}}"
                        Padding="16">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="目前尚無最近整理項目（沒有可整理文件或尚未執行整理）"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text="點擊上方「立即整理」按鈕掃描桌面文書，整理紀錄將即時顯示於此並支援一鍵復原。"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                  </StackPanel>
                </Border>

                <!-- Items List -->
                <ItemsControl ItemsSource="{Binding RecentOrganizedItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                        <Grid VerticalAlignment="Center">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="115" />
                            <ColumnDefinition Width="130" />
                          </Grid.ColumnDefinitions>

                          <!-- File Type Icon & Badge -->
                          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileTypeIconGlyph}" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Border Background="{DynamicResource BrandSurfaceTintBrush}" BorderBrush="{DynamicResource BrandLightBgBrush}" BorderThickness="1" CornerRadius="5" Padding="4,1">
                              <TextBlock Text="{Binding FileTypeBadge}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandDarkBrush}" />
                            </Border>
                          </StackPanel>

                          <!-- File Name -->
                          <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" Margin="0,0,6,0" />

                          <!-- Original Location -->
                          <TextBlock Grid.Column="2" Text="{Binding OriginalLocation}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalLocation}" Margin="0,0,6,0" />

                          <!-- Destination Month -->
                          <TextBlock Grid.Column="3" Text="{Binding TargetMonth}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrandDarkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                          <!-- Timestamp -->
                          <TextBlock Grid.Column="4" Text="{Binding OrganizedTime}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                          <!-- Status Badge -->
                          <Border Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="6" Padding="7,2"
                                  Background="{Binding StatusTone, Converter={StaticResource ToneToBg}}">
                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding StatusTone, Converter={StaticResource ToneToFg}}" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ======================================================= -->
        <!-- PAGE 3: 效能優化 (Performance Optimization)             -->
        <!-- ======================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedPage, Converter={StaticResource PageToVis}, ConverterParameter=Performance}">
          <StackPanel Margin="20,16,20,22"
                      MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- Page Header -->
            <DockPanel Margin="0,0,0,14">
              <Border DockPanel.Dock="Right"
                      VerticalAlignment="Top"
                      CornerRadius="10"
                      Padding="10,5"
                      Margin="10,0,0,0"
                      Background="{Binding MonitorBadgeTone, Converter={StaticResource ToneToBg}}">
                <TextBlock Text="{Binding MonitorBadgeText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{Binding MonitorBadgeTone, Converter={StaticResource ToneToFg}}" />
              </Border>
              <StackPanel>
                <TextBlock Text="電腦效能優化"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="專為 8GB RAM 與 256GB SSD 日常辦公環境設計，僅執行安全、可隨時還原的排程優先權調度。"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>

            <!-- 3 Real-Time Metric Cards: CPU, RAM, SSD -->
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- 1. CPU 使用率 -->
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,2"
                            Background="{Binding CpuStateTone, Converter={StaticResource ToneToBg}}">
                      <TextBlock Text="{Binding CpuStateLabel}" FontSize="10.5" FontWeight="SemiBold"
                                 Foreground="{Binding CpuStateTone, Converter={StaticResource ToneToFg}}" />
                    </Border>
                    <TextBlock Text="CPU 使用率" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBlock Text="{Binding CpuDisplay}" FontSize="28" FontWeight="Bold" Margin="0,6,0,8" />
                  <ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding CpuPercent, Mode=OneWay}" />
                  <TextBlock Text="連續高負載門檻：90%" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- 2. RAM 使用率及可用容量 -->
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,2"
                            Background="{Binding MemoryStateTone, Converter={StaticResource ToneToBg}}">
                      <TextBlock Text="{Binding MemoryStateLabel}" FontSize="10.5" FontWeight="SemiBold"
                                 Foreground="{Binding MemoryStateTone, Converter={StaticResource ToneToFg}}" />
                    </Border>
                    <TextBlock Text="RAM 使用率及可用容量" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBlock Text="{Binding MemoryDisplay}" FontSize="28" FontWeight="Bold" Margin="0,6,0,8" />
                  <ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding MemoryPercent, Mode=OneWay}" />
                  <TextBlock Text="{Binding AvailableMemoryDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrandDarkBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- 3. SSD I/O 壓力及剩餘空間 -->
              <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,2"
                            Background="{Binding DiskStateTone, Converter={StaticResource ToneToBg}}">
                      <TextBlock Text="{Binding DiskStateLabel}" FontSize="10.5" FontWeight="SemiBold"
                                 Foreground="{Binding DiskStateTone, Converter={StaticResource ToneToFg}}" />
                    </Border>
                    <TextBlock Text="SSD I/O 壓力及剩餘空間" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBlock Text="{Binding DiskDisplay}" FontSize="28" FontWeight="Bold" Margin="0,6,0,8" />
                  <ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding DiskPercent, Mode=OneWay}" />
                  <TextBlock Text="{Binding DiskFreeDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- Action Controls & Live System Context Card -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
              <StackPanel>
                <WrapPanel Margin="0,0,0,12">
                  <ui:Button Content="立即效能急救"
                             Appearance="Primary"
                             MinWidth="150"
                             Height="40"
                             Margin="0,0,10,6"
                             Click="RescueButton_Click"
                             IsEnabled="{Binding CanRescue}" />
                  <ui:Button Content="{Binding MonitorButtonText}"
                             Appearance="Secondary"
                             MinWidth="165"
                             Height="40"
                             Margin="0,0,10,6"
                             Click="MonitorButton_Click" />
                  <ui:Button Content="還原暫時設定"
                             Appearance="Secondary"
                             MinWidth="145"
                             Height="40"
                             Margin="0,0,10,6"
                             Click="RestoreSettingsButton_Click" />
                </WrapPanel>

                <Border Style="{StaticResource SoftCardStyle}" Padding="14,10">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="135" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="當前前景應用程式" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ForegroundText}" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="最近介入時間" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastInterventionDisplay}" FontWeight="Medium" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="冷卻時間" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <WrapPanel Grid.Row="4" Grid.Column="1">
                      <TextBlock Text="{Binding CooldownDisplay}" FontWeight="Medium" />
                      <TextBlock Text="　｜　" Foreground="{DynamicResource TextMutedBrush}" />
                      <TextBlock Text="{Binding PressureSampleDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </WrapPanel>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="當前系統狀態" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{StaticResource BrandDarkBrush}" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- Before / After Rescue Intervention Comparison Card -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <Border DockPanel.Dock="Right"
                          CornerRadius="8"
                          Padding="9,3"
                          Background="{Binding RescueImprovementTone, Converter={StaticResource ToneToBg}}">
                    <TextBlock Text="{Binding RescueImprovementBadge}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{Binding RescueImprovementTone, Converter={StaticResource ToneToFg}}" />
                  </Border>
                  <TextBlock Text="效能急救介入前後比較" FontSize="16" FontWeight="SemiBold" />
                </DockPanel>

                <!-- Before -> After Metric Comparison Row -->
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Style="{StaticResource SoftCardStyle}" Padding="12,9">
                    <StackPanel>
                      <TextBlock Text="CPU：介入前 → 介入後" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding RescueCpuComparison}" FontSize="12.5" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Style="{StaticResource SoftCardStyle}" Padding="12,9">
                    <StackPanel>
                      <TextBlock Text="RAM：介入前 → 介入後" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding RescueRamComparison}" FontSize="12.5" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="4" Style="{StaticResource SoftCardStyle}" Padding="12,9">
                    <StackPanel>
                      <TextBlock Text="SSD：介入前 → 介入後" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding RescueSsdComparison}" FontSize="12.5" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- Safe Adjustments & Improvement Analysis -->
                <Border Style="{StaticResource SoftCardStyle}" Padding="12,10">
                  <StackPanel>
                    <TextBlock Text="執行了哪些安全調整：" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding RescueActionsSummary}" FontSize="12.5" FontWeight="Medium" Margin="0,3,0,8" TextWrapping="Wrap" />

                    <TextBlock Text="是否觀察到改善與原因說明：" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding RescueNoImprovementReason}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ======================================================= -->
        <!-- PAGE 4: 活動紀錄 (Activity Log)                         -->
        <!-- ======================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedPage, Converter={StaticResource PageToVis}, ConverterParameter=Activity}">
          <StackPanel Margin="20,16,20,22"
                      MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- Header -->
            <DockPanel Margin="0,0,0,12">
              <ui:Button DockPanel.Dock="Right"
                         Content="重新整理紀錄"
                         Appearance="Secondary"
                         VerticalAlignment="Top"
                         Height="36"
                         Margin="10,0,0,0"
                         Click="RefreshActivityLogButton_Click" />
              <StackPanel>
                <TextBlock Text="活動紀錄"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="完整記錄桌面文件歸檔、復原與安全效能調度歷程，支援依類別篩選查閱。"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>

            <!-- Privacy Notice Banner (Required exact wording in Traditional Chinese) -->
            <Border Style="{StaticResource AccentBannerStyle}" Padding="14,10" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0"
                      Data="{StaticResource GeoShield}"
                      Fill="{StaticResource BrandPrimaryBrush}"
                      Stretch="Uniform"
                      Width="18" Height="18"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0" />
                <TextBlock Grid.Column="1"
                           Text="活動紀錄只保存檔案名稱、路徑、操作結果及效能指標，不讀取或上傳文件內容。"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrandDarkBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </Grid>
            </Border>

            <!-- Filter Bar: 全部 / 文件整理 / 效能優化 / 警告 / 錯誤 + Search -->
            <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,14">
              <DockPanel>
                <TextBox DockPanel.Dock="Right"
                         Width="170"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Margin="8,0,0,0"
                         ToolTip="輸入關鍵字篩選檔案名稱或動作"
                         Text="{Binding ActivitySearchText, UpdateSourceTrigger=PropertyChanged}" />
                <WrapPanel VerticalAlignment="Center">
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="全部"
                               GroupName="ActivityFilterGroup"
                               IsChecked="{Binding SelectedActivityFilter, Converter={StaticResource StringEqToBool}, ConverterParameter=全部, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="文件整理"
                               GroupName="ActivityFilterGroup"
                               IsChecked="{Binding SelectedActivityFilter, Converter={StaticResource StringEqToBool}, ConverterParameter=文件整理, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="效能優化"
                               GroupName="ActivityFilterGroup"
                               IsChecked="{Binding SelectedActivityFilter, Converter={StaticResource StringEqToBool}, ConverterParameter=效能優化, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="警告"
                               GroupName="ActivityFilterGroup"
                               IsChecked="{Binding SelectedActivityFilter, Converter={StaticResource StringEqToBool}, ConverterParameter=警告, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource FilterPillRadioButtonStyle}"
                               Content="錯誤"
                               GroupName="ActivityFilterGroup"
                               IsChecked="{Binding SelectedActivityFilter, Converter={StaticResource StringEqToBool}, ConverterParameter=錯誤, Mode=TwoWay}" />
                </WrapPanel>
              </DockPanel>
            </Border>

            <!-- Activity Log Table Card -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding ActivityCountSummary}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="操作與調度明細" FontSize="15.5" FontWeight="SemiBold" />
                </DockPanel>

                <!-- Table Header: 時間 / 類別 / 動作 / 對象 / 執行結果 -->
                <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="135" />
                      <ColumnDefinition Width="84" />
                      <ColumnDefinition Width="115" />
                      <ColumnDefinition Width="1.1*" />
                      <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="時間" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="類別" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="動作" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="對象" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="執行結果" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Grid>
                </Border>

                <!-- Empty State -->
                <Border Style="{StaticResource SoftCardStyle}"
                        Visibility="{Binding HasFilteredActivityItems, Converter={StaticResource InverseBoolToVis}}"
                        Padding="18">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="目前篩選條件下尚無活動紀錄"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="當您執行「立即整理」、「復原上次整理」或「立即效能急救」後，紀錄將即時列於此處。"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                  </StackPanel>
                </Border>

                <!-- Activity Rows -->
                <ItemsControl ItemsSource="{Binding FilteredActivityItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                        <Grid VerticalAlignment="Center">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="115" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.5*" />
                          </Grid.ColumnDefinitions>

                          <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                          <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="6" Padding="7,2"
                                  Background="{Binding StatusTone, Converter={StaticResource ToneToBg}}">
                            <TextBlock Text="{Binding CategoryDisplay}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding StatusTone, Converter={StaticResource ToneToFg}}" />
                          </Border>

                          <TextBlock Grid.Column="2" Text="{Binding ActionDisplay}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="Wrap" />

                          <TextBlock Grid.Column="3" Text="{Binding TargetDisplay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetDisplay}" />

                          <TextBlock Grid.Column="4" Text="{Binding ResultDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ======================================================= -->
        <!-- PAGE 5: 設定 (Settings)                                 -->
        <!-- ======================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedPage, Converter={StaticResource PageToVis}, ConverterParameter=Settings}">
          <StackPanel Margin="20,16,20,22"
                      MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <TextBlock Text="系統與偏好設定"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="調整桌面文件自動整理規則、背景智慧效能監控門檻及一般外觀偏好。"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,14" />

            <!-- SECTION 1: 文件整理設定 -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="文件整理設定" FontSize="16.5" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- 自動整理 -->
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="自動整理" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding AutoOrganizeEnabled}">
                    <TextBlock Text="定期自動掃描並歸檔桌面第一層文書" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- 檢查間隔 -->
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="檢查間隔" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding ScanIntervalOptions}" SelectedItem="{Binding ScanIntervalMinutes, Mode=TwoWay}" Width="82" />
                    <TextBlock Text="分鐘（預設 15 分鐘）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>

                  <!-- 新文件等待時間 -->
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="新文件等待時間" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding NewFileWaitOptions}" SelectedItem="{Binding NewFileWaitMinutes, Mode=TwoWay}" Width="82" />
                    <TextBlock Text="分鐘（預設 60 分鐘，避免搬移剛下載或編輯中的文件）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                  </WrapPanel>

                  <!-- 整理資料夾 -->
                  <TextBlock Grid.Row="6" Grid.Column="0" Text="整理資料夾" FontWeight="Medium" VerticalAlignment="Center" />
                  <DockPanel Grid.Row="6" Grid.Column="1">
                    <ui:Button DockPanel.Dock="Right" Content="開啟整理資料夾" Appearance="Secondary" Height="30" FontSize="12" Margin="8,0,0,0" Click="OpenOrganizedFolder_Click" />
                    <TextBox Text="{Binding OrganizedFolderName, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" Height="30" Padding="8,0" />
                  </DockPanel>

                  <!-- 重複檔識別 -->
                  <TextBlock Grid.Row="8" Grid.Column="0" Text="重複檔識別" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding DuplicateCheckEnabled}">
                    <TextBlock Text="同名檔案以 SHA-256 比對內容；相同內容移入「重複檔 Duplicates」" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- 復原紀錄 -->
                  <TextBlock Grid.Row="10" Grid.Column="0" Text="復原紀錄" FontWeight="Medium" VerticalAlignment="Center" />
                  <DockPanel Grid.Row="10" Grid.Column="1">
                    <ui:Button DockPanel.Dock="Right" Content="復原上次整理" Appearance="Secondary" Height="30" FontSize="12" Margin="8,0,0,0" Click="UndoButton_Click" IsEnabled="{Binding CanOrganize}" />
                    <TextBlock Text="{Binding UndoStatusBadge}" VerticalAlignment="Center" Foreground="{StaticResource BrandDarkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </DockPanel>
                </Grid>

                <!-- 文件格式 (15 supported extensions) -->
                <Separator Background="{DynamicResource DividerBrush}" Margin="0,12,0,10" />
                <DockPanel Margin="0,0,0,8">
                  <ui:Button DockPanel.Dock="Right" Content="恢復預設 15 種格式" Appearance="Secondary" Height="28" FontSize="11.5" Click="ResetDefaultFormatsButton_Click" />
                  <TextBlock Text="文件格式（勾選要納入自動整理的文書副檔名）" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding FormatChips}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,6,6">
                        <CheckBox Content="{Binding DisplayLabel}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- SECTION 2: 效能設定 -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="效能設定" FontSize="16.5" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- 背景監控 -->
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="背景監控" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding BackgroundMonitoringEnabled}">
                    <TextBlock Text="啟動低頻背景智慧監控（連續壓力達標才自動調度）" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- 監控間隔 -->
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="監控間隔" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding MonitorIntervalOptions}" SelectedItem="{Binding MonitorIntervalSeconds, Mode=TwoWay}" Width="82" />
                    <TextBlock Text="秒（預設 5 秒低開銷取樣）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>

                  <!-- 連續壓力觸發次數 -->
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="連續壓力觸發次數" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding PressureTriggerOptions}" SelectedItem="{Binding PressureTriggerCount, Mode=TwoWay}" Width="82" />
                    <TextBlock Text="次（預設連續 3 次達標才介入）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>

                  <!-- 冷卻時間 -->
                  <TextBlock Grid.Row="6" Grid.Column="0" Text="冷卻時間" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="6" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding CooldownMinuteOptions}" SelectedItem="{Binding CooldownMinutes, Mode=TwoWay}" Width="82" />
                    <TextBlock Text="分鐘（預設 5 分鐘，避免頻繁重複介入）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>

                  <!-- 停止時自動還原 -->
                  <TextBlock Grid.Row="8" Grid.Column="0" Text="停止時自動還原" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding AutoRestoreOnStop}">
                    <TextBlock Text="停止背景監控或退出程式時，自動還原所有暫時優先權調整" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- SSD 空間警告門檻 -->
                  <TextBlock Grid.Row="10" Grid.Column="0" Text="SSD 空間警告門檻" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="10" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding SsdThresholdOptions}" SelectedItem="{Binding SsdWarningThresholdPercent, Mode=TwoWay}" Width="82" />
                    <TextBlock Text="%（預設低於 15% 時提醒保留可用空間）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- SECTION 3: 一般設定 -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
              <StackPanel>
                <TextBlock Text="一般設定" FontSize="16.5" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- 隨 Windows 登入啟動 -->
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="隨 Windows 登入啟動" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding LaunchAtLoginPreference}">
                    <TextBlock Text="記住登入啟動偏好（可由安裝程式設定隨 Windows 登入自動啟動）" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- 啟動後最小化 -->
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="啟動後最小化" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding StartMinimizedPreference}">
                    <TextBlock Text="程式啟動時自動最小化視窗，不打擾日常辦公" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- 關閉視窗後留在系統匣 -->
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="關閉視窗後留在系統匣" FontWeight="Medium" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"
                            IsChecked="{Binding MinimizeToTrayOnClose}">
                    <TextBlock Text="點擊右上角關閉按鈕時最小化至系統匣繼續守護" TextWrapping="Wrap" />
                  </CheckBox>

                  <!-- 主題 -->
                  <TextBlock Grid.Row="6" Grid.Column="0" Text="主題" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="6" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}" Width="110" />
                    <TextBlock Text="（Light 淺色主題為主，支援 Dark 深色主題）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>

                  <!-- 語言 -->
                  <TextBlock Grid.Row="8" Grid.Column="0" Text="語言" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="8" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguageMode, Mode=TwoWay}" Width="110" />
                    <TextBlock Text="（繁體中文介面）" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>

                  <!-- 開啟日誌資料夾 -->
                  <TextBlock Grid.Row="10" Grid.Column="0" Text="開啟日誌資料夾" FontWeight="Medium" VerticalAlignment="Center" />
                  <WrapPanel Grid.Row="10" Grid.Column="1" VerticalAlignment="Center">
                    <ui:Button Content="開啟日誌資料夾" Appearance="Secondary" Height="32" FontSize="12" Click="OpenLogFolder_Click" />
                    <TextBlock Text="{Binding DataDirectoryDisplay}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                  </WrapPanel>

                  <!-- 版本資訊 -->
                  <TextBlock Grid.Row="12" Grid.Column="0" Text="版本資訊" FontWeight="Medium" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding AppVersionDisplay}" FontWeight="SemiBold" Foreground="{StaticResource BrandDarkBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ======================================================= -->
        <!-- PAGE 6: 使用說明 (User Guide & Dynamic Paths)           -->
        <!-- ======================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SelectedPage, Converter={StaticResource PageToVis}, ConverterParameter=Guide}">
          <StackPanel Margin="20,16,20,22"
                      MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- Brand Banner Header -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="16,12">
              <DockPanel>
                <ui:Button DockPanel.Dock="Right"
                           Content="重新產生說明書"
                           Appearance="Primary"
                           VerticalAlignment="Center"
                           Height="38"
                           Margin="12,0,0,0"
                           Click="GenerateManualButton_Click" />
                <Image Source="pack://application:,,,/SmartDesktopGuardian;component/Resources/Brand/logo-full-light.png"
                       Height="68"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality" />
              </DockPanel>
            </Border>

            <!-- Dynamic Portable Paths Card (5 Required Paths) -->
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock DockPanel.Dock="Right"
                             Text="依目前執行環境與登入使用者自動偵測"
                             FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="動態可攜式路徑資訊" FontSize="16.5" FontWeight="SemiBold" />
                </DockPanel>

                <Border Style="{StaticResource SoftCardStyle}" Padding="14,12">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="8" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="145" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="當前安裝路徑" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstallPathDisplay}" FontFamily="Consolas, Microsoft JhengHei UI" FontSize="12" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="當前桌面路徑" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DesktopPath}" FontFamily="Consolas, Microsoft JhengHei UI" FontSize="12" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="當前整理資料夾路徑" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OrganizedPath}" FontFamily="Consolas, Microsoft JhengHei UI" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandDarkBrush}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="設定檔路徑" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SettingsFilePathDisplay}" FontFamily="Consolas, Microsoft JhengHei UI" FontSize="12" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="日誌路徑" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding LogFilePathDisplay}" FontFamily="Consolas, Microsoft JhengHei UI" FontSize="12" TextWrapping="Wrap" />
                  </Grid>
                </Border>

                <WrapPanel Margin="0,10,0,0">
                  <ui:Button Content="重新產生說明書" Appearance="Secondary" Height="34" FontSize="12" Margin="0,0,8,0" Click="GenerateManualButton_Click" />
                  <ui:Button Content="開啟整理資料夾" Appearance="Secondary" Height="34" FontSize="12" Margin="0,0,8,0" Click="OpenOrganizedFolder_Click" />
                  <ui:Button Content="開啟日誌資料夾" Appearance="Secondary" Height="34" FontSize="12" Click="OpenLogFolder_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- Guide Cards: Rules & Safety Principles -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                  <TextBlock Text="一、桌面文件整理說明" FontSize="15.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <TextBlock Text="• 只檢查目前使用者桌面第一層，絕不移動資料夾、捷徑 (.lnk)、圖片、影音或應用程式執行檔。" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" />
                  <TextBlock Text="• 依檔案最後修改時間自動歸檔至「整理 Organized\yyyy年MM月」資料夾。" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" />
                  <TextBlock Text="• 正在開啟或編輯中的文件會自動略過；同名但內容不同者自動加序號保留；SHA-256 相同內容者移入「重複檔 Duplicates」。" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" />
                  <TextBlock Text="• 保留最近 100 批整理紀錄，隨時可點擊「復原上次整理」將檔案放回桌面。" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrandDarkBrush}" FontWeight="Medium" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                  <TextBlock Text="二、安全效能守護說明" FontSize="15.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <TextBlock Text="• 專為 8GB RAM、256GB SSD 辦公電腦最佳化，即時監控 CPU、記憶體與磁碟 I/O 壓力。" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" />
                  <TextBlock Text="• 僅對非前景且長時間高耗能的背景程式暫時調降排程優先權，並提升目前前景程式反應流暢度。" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" />
                  <TextBlock Text="• 嚴格安全承諾：絕不強制關閉應用程式、不清空 Windows Standby 快取、不停用 Pagefile 或系統服務。" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" />
                  <TextBlock Text="• 所有優先權調整皆為暫時性，停止監控或點擊「還原暫時設定」即可立即恢復。" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrandDarkBrush}" FontWeight="Medium" />
                </StackPanel>
              </Border>
            </Grid>

          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
