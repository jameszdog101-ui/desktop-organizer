<ui:FluentWindow x:Class="PerformanceGuardian.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Smart Desktop Guardian" Width="1000" Height="760"
    MinWidth="860" MinHeight="640" WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ui:TitleBar Title="Smart Desktop Guardian｜智慧桌面管家" />
    <TabControl Grid.Row="1" Margin="24,12,24,24">
      <TabItem Header="首页">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <TextBlock Text="电脑与桌面，一处管理" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="文件按月份自动归档，并在资源紧张时安全调度效能。" Foreground="#667085" Margin="0,8,0,22"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="文件自动整理" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding OrganizerSummary}" TextWrapping="Wrap" Foreground="#475467" Margin="0,10,0,14"/><ui:Button Content="立即整理桌面文件" Appearance="Primary" Height="44" Click="OrganizeNowButton_Click"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="电脑效能" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#475467" Margin="0,10,0,14"/><ui:Button Content="立即效能急救" Appearance="Primary" Height="44" Click="RescueButton_Click" IsEnabled="{Binding CanRescue}"/></StackPanel></Border>
          </Grid>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="文件整理">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Left"><TextBlock Text="桌面文件整理" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="自动整理常见文书，并依月份归档。" Foreground="#667085" Margin="0,6,0,0"/></StackPanel><CheckBox Content="自动整理" IsChecked="{Binding AutoOrganizeEnabled}" VerticalAlignment="Center" FontSize="15" HorizontalAlignment="Right"/></DockPanel>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="监控桌面" Foreground="#667085"/><TextBlock Text="整理资料夹" Foreground="#667085" Margin="0,12,0,0"/><TextBlock Text="分类方式" Foreground="#667085" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding DesktopPath}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding OrganizedPath}" TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/><TextBlock Text="2026年10月、2026年11月……" Margin="0,12,0,0"/></StackPanel></Grid></Border>
          <WrapPanel Margin="0,0,0,14"><ui:Button Content="立即整理" Appearance="Primary" MinWidth="140" Height="44" Margin="0,0,10,0" Click="OrganizeNowButton_Click" IsEnabled="{Binding CanOrganize}"/><ui:Button Content="复原上次整理" Appearance="Secondary" MinWidth="150" Height="44" Margin="0,0,10,0" Click="UndoButton_Click" IsEnabled="{Binding CanOrganize}"/><ui:Button Content="开启整理资料夹" Appearance="Secondary" MinWidth="160" Height="44" Click="OpenOrganizedFolder_Click"/></WrapPanel>
          <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="执行状态" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding OrganizerStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#475467"/><TextBlock Text="支援 PDF、Word、Excel、PowerPoint、文字及开放文件格式" FontSize="12" Foreground="#667085" Margin="0,12,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="效能优化">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <TextBlock Text="电脑效能优化" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="针对 8GB RAM 与 256GB SSD 的安全资源调度。" Foreground="#667085" Margin="0,6,0,18"/>
          <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="CPU" Foreground="#667085"/><TextBlock Text="{Binding CpuDisplay}" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,10"/><ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding CpuPercent}"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="RAM" Foreground="#667085"/><TextBlock Text="{Binding MemoryDisplay}" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,10"/><ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding MemoryPercent}"/><TextBlock Text="{Binding AvailableMemoryDisplay}" FontSize="11" Foreground="#667085" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="SSD I/O 压力" Foreground="#667085"/><TextBlock Text="{Binding DiskDisplay}" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,10"/><ProgressBar Style="{StaticResource MetricBarStyle}" Value="{Binding DiskPercent}"/><TextBlock Text="{Binding DiskProfile}" FontSize="11" Foreground="#667085" Margin="0,7,0,0"/></StackPanel></Border>
          </Grid>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="目前状态" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding ForegroundText}" Margin="0,8,0,0" FontSize="12" Foreground="#667085"/></StackPanel></Border>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:Button Content="立即效能急救" Appearance="Primary" Height="48" Click="RescueButton_Click" IsEnabled="{Binding CanRescue}"/><ui:Button Grid.Column="2" Content="{Binding MonitorButtonText}" Appearance="Secondary" Height="48" Click="MonitorButton_Click"/></Grid>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="设定与说明">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <TextBlock Text="设定与使用说明" FontSize="26" FontWeight="SemiBold"/>
          <Border Style="{StaticResource CardStyle}" Margin="0,18,0,14"><StackPanel><TextBlock Text="自动整理规则" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="每 15 分钟检查一次；新文件等待 60 分钟。程序不会读取文件内容，重复档比对时仅计算 SHA-256。" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="程序关闭后不会继续整理；可在安装时选择随 Windows 登录启动。" TextWrapping="Wrap" Foreground="#667085" Margin="0,6,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="可携式路径" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding PathSummary}" TextWrapping="Wrap" Margin="0,8,0,0"/><ui:Button Content="重新产生说明书" Appearance="Secondary" HorizontalAlignment="Left" Margin="0,14,0,0" Click="GenerateManualButton_Click"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</ui:FluentWindow>
