<Application x:Class="PerformanceGuardian.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="AccentBrush" Color="#0D9488" />
      <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
      <SolidColorBrush x:Key="CardBrush" Color="#F4F6F8" />
      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
      </Style>
      <Style x:Key="MetricBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="7" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="#DDE2E7" />
        <Style.Triggers>
          <Trigger Property="Value" Value="100"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
